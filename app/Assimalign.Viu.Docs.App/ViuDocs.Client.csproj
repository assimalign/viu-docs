<Project Sdk="Assimalign.Viu.Sdk.Browser/10.0.0-beta.12">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ViuDocs</RootNamespace>
    <AssemblyName>ViuDocs</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <ViuRunAotCompilation Condition="'$(ViuRunAotCompilation)' == ''">false</ViuRunAotCompilation>
    <GenerateRequiresPreviewFeaturesAttribute>true</GenerateRequiresPreviewFeaturesAttribute>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Assimalign.Viu.Docs\src\Assimalign.Viu.Docs.csproj" />
    <PackageReference Include="Assimalign.Frontend.Components" Version="1.0.0-preview.1" />
    <PackageReference Include="Assimalign.Cohesion.Viu.Hosting" Version="10.0.0-beta.5" />
    <PackageReference Include="Assimalign.Cohesion.Viu.Hosting.Browser" Version="10.0.0-beta.5" />
    <PackageReference Include="Assimalign.Cohesion.Viu.DevServer" Version="10.0.0-beta.5" />
    <PackageReference Include="Assimalign.Viu.Browser.Router" Version="10.0.0-beta.12" />
    <PackageReference Include="Assimalign.Viu.Router" Version="10.0.0-beta.12" />
  </ItemGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS"
                                      Pattern="*.js"
                                      Expression="#[.{fingerprint}]!" />
  </ItemGroup>
</Project>
