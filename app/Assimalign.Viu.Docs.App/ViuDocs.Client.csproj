<Project Sdk="Assimalign.Viu.Sdk.Browser">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ViuDocs</RootNamespace>
    <AssemblyName>ViuDocs</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <ViuRunAotCompilation Condition="'$(ViuRunAotCompilation)' == ''">false</ViuRunAotCompilation>
    <GenerateRequiresPreviewFeaturesAttribute>true</GenerateRequiresPreviewFeaturesAttribute>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Assimalign.Viu.Docs\src\Assimalign.Viu.Docs.csproj" />
    <PackageReference Include="Assimalign.Frontend.Components" Version="$(FrontendVersion)" />
    <PackageReference Include="Assimalign.Cohesion.Viu.Hosting" Version="$(CohesionViuVersion)" />
    <PackageReference Include="Assimalign.Cohesion.Viu.Hosting.Browser" Version="$(CohesionViuVersion)" />
    <PackageReference Include="Assimalign.Cohesion.Viu.Routing" Version="$(CohesionViuVersion)" />
    <PackageReference Include="Assimalign.Cohesion.Viu.DevServer" Version="$(CohesionViuVersion)" />
    <PackageReference Include="Assimalign.Viu.Router" Version="$(ViuVersion)" />
  </ItemGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS"
                                      Pattern="*.js"
                                      Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <Import Project="..\..\packages\Assimalign.Viu.Docs\build\Assimalign.Viu.Docs.ProjectReference.props" />
</Project>
