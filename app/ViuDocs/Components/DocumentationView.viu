<template>
    <section class="documentation-panel" :aria-busy="BusyState">
        <div v-if="IsLoading" class="documentation-state" role="status">
            <span class="loading-indicator" aria-hidden="true"></span>
            <h2>Loading documentation…</h2>
            <p>Fetching the Markdown asset and rendering it in the browser.</p>
        </div>

        <div v-else-if="HasError" class="documentation-state documentation-state--error" role="alert">
            <span class="state-code">404</span>
            <h2>Documentation page unavailable</h2>
            <p>{{ ErrorMessage }}</p>
            <RouterLink to="/" class="return-link">Return to the documentation index</RouterLink>
        </div>

        <article v-else class="markdown-body" v-html="RenderedHtml"></article>
    </section>
</template>

@script {
    using System;
    using System.Threading;
    using System.Threading.Tasks;

    using Assimalign.Viu.Components;
    using Assimalign.Viu.Reactivity;

    private DocumentationContentService Content { get; set; } = null!;

    private readonly Reference<bool> Loading = Reactive.Reference(false);

    private readonly Reference<string> Html = Reactive.Reference(string.Empty);

    private readonly Reference<string?> Error = Reactive.Reference<string?>(null);

    private string? ActiveRoute { get; set; }

    private int RequestVersion { get; set; }

    [Parameter("pathMatch")]
    public string RequestedPath { get; set; } = string.Empty;

    public bool IsLoading => Loading.Value;

    public bool HasError => Error.Value is not null;

    public string ErrorMessage => Error.Value ?? string.Empty;

    public string RenderedHtml => Html.Value;

    public string BusyState => IsLoading ? "true" : "false";

    partial void OnSetup()
    {
        Content = (DocumentationContentService?)Context!.Services?.GetService(
            typeof(DocumentationContentService))
            ?? throw new InvalidOperationException(
                "The documentation content service is unavailable.");

        Context.Lifecycle.OnMounted(LoadCurrentPageAsync);
        Context.Lifecycle.OnUpdated(LoadCurrentPageAsync);
        Context.Lifecycle.OnServerPrefetch(LoadCurrentPageAsync);
    }

    private async Task LoadCurrentPageAsync(CancellationToken cancellationToken)
    {
        string route = DocumentationCatalog.RouteFromCatchAll(RequestedPath);
        if (string.Equals(route, ActiveRoute, StringComparison.Ordinal))
        {
            return;
        }

        ActiveRoute = route;
        int requestVersion = ++RequestVersion;

        DocumentationPage? page = DocumentationCatalog.FindByRoute(route);
        if (page is null)
        {
            Loading.Value = false;
            Html.Value = string.Empty;
            Error.Value = $"No documentation asset is registered for {route}.";
            return;
        }

        Loading.Value = true;
        Html.Value = string.Empty;
        Error.Value = null;

        try
        {
            string renderedHtml = await Content.RenderAsync(page, cancellationToken);
            if (requestVersion != RequestVersion)
            {
                return;
            }

            Html.Value = renderedHtml;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            if (requestVersion != RequestVersion)
            {
                return;
            }

            Error.Value = $"{page.AssetPath}: {exception.Message}";
        }
        finally
        {
            if (requestVersion == RequestVersion)
            {
                Loading.Value = false;
            }
        }
    }
}
