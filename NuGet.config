<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Project-SDK resolution reads this file before restore properties exist, so the global.json
       msbuild-sdks pins resolve through these same sources. The pipeline uses this file unchanged. -->
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <!-- Viu, Viu Platforms, Cohesion, and shared frontend CI builds (*.ci.N) and releases. GitHub
         Packages requires a classic token with read:packages even for public packages. Never commit
         it; supply it from the environment:
         NuGetPackageSourceCredentials_assimalign=Username=<user>;Password=<token>;ValidAuthenticationTypes=Basic -->
    <add key="assimalign" value="https://nuget.pkg.github.com/assimalign/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="assimalign">
      <package pattern="Assimalign.Viu.*" />
      <package pattern="Assimalign.Cohesion.*" />
      <package pattern="Assimalign.Frontend.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <assimalign>
      <add key="Username" value="%GITHUB_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_PASSWORD%" />
    </assimalign>
    <example>
      <add key="Username" value="%GITHUB_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_PASSWORD%" />
    </example>
  </packageSourceCredentials>
</configuration>
