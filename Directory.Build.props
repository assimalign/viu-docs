<Project>
  <PropertyGroup>
    <!-- The package pins, all restored from the Assimalign GitHub Packages feed. global.json's
         Assimalign.Viu.Sdk entry is the one Viu pin: it selects the SDK, and every Viu package
         reference restores the same build. global.json's Assimalign.Cohesion.Sdk entries select the
         Cohesion build that CohesionViuVersion pins exactly. CohesionViuVersion (viu-platforms) and
         FrontendVersion (aaln-core-frontend) must remain runtime-compatible with those builds;
         its older declared minimum dependencies do not require a frontend republish by themselves.
         Move SDK/runtime/hosting pins together and validate the shared frontend. -->
    <_ViuDocsGlobalJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)global.json'))</_ViuDocsGlobalJson>
    <ViuVersion>$([System.Text.RegularExpressions.Regex]::Replace($(_ViuDocsGlobalJson), '(?s)^.*"Assimalign\.Viu\.Sdk"\s*:\s*"([^"]+)".*$', '$1'))</ViuVersion>
    <CohesionViuVersion>10.0.0-preview.0.ci.12</CohesionViuVersion>
    <FrontendVersion>1.0.0-preview.1.ci.2</FrontendVersion>
  </PropertyGroup>
</Project>
